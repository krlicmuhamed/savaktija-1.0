{
  "manifest_version": 3,
  "name": "Savaktija",
  "version": "1.0",
  "description": "A playful cup animation and prayer-card shuffle for vaktija.ba.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "homepage_url": "https://vaktija.ba/",
  "content_scripts": [
    {
      "matches": [
        "https://vaktija.ba/*",
        "https://*.vaktija.ba/*"
      ],
      "css": [
        "css/savaktija.css"
      ],
      "js": [
        "savaktija.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
